# ============================================================
# Environment variables template — copy to .env and fill in
# NEVER commit .env — add to .gitignore
# All secret values must come from env vars (design.md §6)
# ============================================================

# --- Database (Neon PostgreSQL) ---
# Get from Neon dashboard → your project → dev branch → Connection string
# psycopg3 expects a plain "postgresql://" URI (NOT the SQLAlchemy-style
# "postgresql+psycopg://" form).
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# Java datasource (JDBC format)
# DATABASE_URL_JDBC=jdbc:postgresql://ep-xxx.neon.tech/dbname?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# --- JWT (Java Backend) ---
# At least 32 random characters for HS256
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# --- Internal API key (Java ↔ Python) ---
# Any shared secret; both services must use the same value
INTERNAL_API_KEY=REPLACE_WITH_RANDOM_SECRET

# --- AI Service base URL (Java → Python) ---
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_SECONDS=40

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Admin seed (Flyway V010) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# --- Embedding provider (Python AI Service) ---
# "mock" (dev/test, no API call) | "gemini" | "groq"
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-004

# Only needed when EMBEDDING_PROVIDER != mock:
# GEMINI_API_KEY=
# GROQ_API_KEY=
